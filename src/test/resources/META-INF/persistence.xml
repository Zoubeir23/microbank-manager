<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- Unite de persistance des tests : base H2 en memoire, recreee a chaque execution.
         Les tests ne dependent donc d'aucun PostgreSQL demarre. -->
    <persistence-unit name="microbank-test-pu" transaction-type="RESOURCE_LOCAL">

        <class>sn.isi.iage.microbank.model.User</class>
        <class>sn.isi.iage.microbank.model.Client</class>
        <class>sn.isi.iage.microbank.model.ClientDocument</class>
        <class>sn.isi.iage.microbank.model.Agency</class>
        <class>sn.isi.iage.microbank.model.Account</class>
        <class>sn.isi.iage.microbank.model.Operation</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:mem:microbank;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>

    </persistence-unit>

</persistence>
